# ==============================================================================
# PONS CREATOR FEE FUNDING MARKET - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND & WEB3 CONNECTIONS (Public Client)
# ------------------------------------------------------------------------------
# Active Chain: Robinhood Chain Testnet (46630) or Mainnet (4663)
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deployed Contract Addresses (Defaults loaded from deployments.json if empty)
NEXT_PUBLIC_FACTORY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_PONS_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_TREASURY_ADDRESS=0x9178B573219C55586BbAf51Ecb24ACfb27BB7681
NEXT_PUBLIC_SAMPLE_POOL=0xCafac3dD18aC6c6e92c921884f9E4176737C052c

# Optional: WalletConnect / Reown Cloud Project ID (get free at https://cloud.reown.com)
# Only required if using QR code mobile wallets. Injected (Phantom, MetaMask, Rabby) works without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ------------------------------------------------------------------------------
# 2. SMART CONTRACT DEPLOYMENT (Hardhat)
# ------------------------------------------------------------------------------
# Private key of the deployer account for testnet/mainnet deployment.
# NEVER commit your real private key!
DEPLOYER_PRIVATE_KEY=

# RPC Endpoints for Hardhat
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Blockscout Explorer URL
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com/api

# ------------------------------------------------------------------------------
# 3. CAMPAIGN ESCROW & OPERATOR (Brief Sec. 18)
# ------------------------------------------------------------------------------
# Operator wallet/multisig that receives escrow funds to execute DEX Screener purchase
CAMPAIGN_OPERATOR_ADDRESS=0x9178B573219C55586BbAf51Ecb24ACfb27BB7681

# Chainlink or price feed oracle for ETH/USD target locking (optional in testnet)
ETH_USD_FEED_ADDRESS=

# ------------------------------------------------------------------------------
# 4. NEONDB / POSTGRESQL (Offchain Indexer & Caching)
# ------------------------------------------------------------------------------
# Get your free serverless Postgres connection string at https://neon.tech
DATABASE_URL=


# ===== Phase 0-1: fork test + deploy contracts =====
# Public RPC, no key needed (rate limited). Swap for QuickNode/Alchemy/Dwellir URL for heavy use.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_TESTNET_CHAIN_ID=46630

# Pons V2 (from github.com/ponsdotdev/pons-labs README)
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e

# Deployer wallet. Use a fresh throwaway wallet, NEVER your main one. Testnet first.
DEPLOYER_PRIVATE_KEY=

# Contract verification (Blockscout; usually no key, leave blank unless required)
ETHERSCAN_API_KEY=
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com/api

# ===== Phase 2: indexer =====
# Postgres for indexed events
DATABASE_URL=postgres://user:pass@localhost:5432/pons_market
# Dedicated RPC for log scanning (public RPC will throttle)
INDEXER_RPC_URL=
# DEX Screener public API: no key needed (api.dexscreener.com)

# ===== Phase 3: frontend =====
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
# WalletConnect / Reown project id (free at cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ===== Phase 4: campaign execution =====
# Operator wallet that receives escrow releases. Prefer a multisig (Safe), not a raw key.
CAMPAIGN_OPERATOR_ADDRESS=
# ETH/USD price source for locking the target (Chainlink feed address on Robinhood Chain)
ETH_USD_FEED_ADDRESS=
